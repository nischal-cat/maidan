# Get from Neon Dashboard -> Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_A_128_CHAR_HEX_STRING_HERE"

# Leave NODE_ENV=development for local work. Setting it to anything else (in
# particular production) stops one-time codes from being written to the console.
NODE_ENV=development

# Backend HTTP port. Keep this in sync with VITE_DEV_API_TARGET in the frontend
# .env, because the Vite dev server proxies /api and /uploads here.
PORT=5001

# Frontend origin (Vite dev server).
FRONTEND_URL=http://localhost:5173

# Firebase Authentication (console.firebase.google.com -> Project settings)
# Google sign-in on the frontend runs through Firebase; the backend verifies the
# ID tokens using the public project ID. A service account is OPTIONAL — it is
# only needed if the backend ever performs privileged auth actions (creating
# users, resetting passwords, etc.).
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Optional — either the path to a downloaded service account JSON, or the same
# JSON base64-encoded. Skip unless you need privileged auth operations.
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_B64=PASTE_BASE64_OF_SERVICE_ACCOUNT_JSON

# Payment Gateway - eSewa Sandbox
# Test credentials from: https://developer.esewa.com.np/pages/Test-credentials
APP_BASE_URL=http://localhost:5000
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=YOUR_ESEWA_SECRET_KEY_HERE
