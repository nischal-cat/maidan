# Backend API base URL.
# Use the RELATIVE path "/api" so the browser only calls the same origin it loaded
# the app from. The Vite dev server proxies /api and /uploads to the backend (see
# vite.config.ts), which keeps the app working on localhost and also when the dev
# server is published through a tunnel, where "localhost" would otherwise point
# at the visitor's own machine.
VITE_API_URL=/api

# Where the dev server proxies /api and /uploads. Must match PORT in
# maidan-backend/.env.
VITE_DEV_API_TARGET=http://127.0.0.1:5001

# Extra hostnames the dev server may be served from, comma separated. Needed only
# when the dev server is exposed to a tunnel or a LAN address; leave empty for
# plain localhost. Example: ALLOWED_HOSTS=my-tunnel-host.trycloudflare.com
ALLOWED_HOSTS=

# Firebase Authentication (console.firebase.google.com -> Project settings -> General)
# Google sign-in runs on the client through Firebase; the backend verifies the ID tokens.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# Optional: match the rest of the Firebase web config if you use other services
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
